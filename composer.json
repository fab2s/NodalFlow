{
    "name" : "fab2s/nodalflow",
    "description" : "A PHP Nodal WorkFlow",
    "type" : "library",
    "authors" : [{
        "name" : "Fabrice de Stefanis"
    }],
    "keywords" : [
        "PHP",
        "NodalFlow",
        "WorkFlow",
        "Nodal",
        "Node",
        "Graph",
        "Executable",
        "Network",
        "Traversable",
        "Data-Processing",
        "Serializable"
    ],
    "license" : [
        "MIT"
    ],
    "require" : {
        "php": "^8.2",
        "fab2s/context-exception": "^3.0",
        "fab2s/souuid": "^1.0",
        "symfony/contracts": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
        "laravel/pint": "^1.21.2"
    },
    "suggest": {
        "symfony/event-dispatcher": "To use FlowEvents"
    },
    "autoload": {
        "psr-4": {
            "fab2s\\NodalFlow\\": "src"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "rm -rf .*.cache"
        ],
        "post-install-cmd": [
            "rm -rf .*.cache"
        ],
        "fix": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pint --ansi --config pint.json --"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpunit --colors --"
        ],
        "cov": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpunit --colors --coverage-html ./cov --"
        ]
    }
}
